# Optional keys for the literature-search pipeline (pipelines/src/literature-search.ts). Copy to .env (git-ignored).
# None of these values is ever written into the dataset or the exports.
OPENALEX_API_KEY=        # free key from https://openalex.org/rest-api — its own daily budget; unaffected when the anonymous pool is paused
OPENALEX_MAILTO=         # contact address for OpenAlex's polite pool (owner ruling pending, exception 4463)
S2_API_KEY=              # Semantic Scholar key (owner exception e953); the anonymous pool answers 429
